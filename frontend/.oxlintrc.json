{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "nextjs", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css", "@testing-library/jest-dom/vitest"]
      }
    ]
  },
  "ignorePatterns": [
    ".next/**",
    ".next-e2e/**",
    ".next-e2e-live/**",
    "node_modules/**",
    "next-env.d.ts",
    "playwright-report/**",
    "test-results/**"
  ]
}
