# Copy to backend/.env (git-ignored) and fill in. Never commit real values.
# LLM provider keys are optional; without them the pipeline falls back to rules-only output.
GROQ_API_KEY=
GEMINI_API_KEY=
LITELLM_MASTER_KEY=
POSTGRES_PASSWORD=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# Traces (optional; `make up-obs` starts Phoenix). Unset = no export. Phoenix takes OTLP/HTTP on
# its UI port, 56006 (the exporter appends /v1/traces); UI at http://127.0.0.1:56006.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:56006
# OTEL_SERVICE_NAME=sluice
